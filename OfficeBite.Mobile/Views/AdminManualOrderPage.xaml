<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OfficeBite.Mobile.Views.AdminManualOrderPage"
             Title="Manual Order"
             BackgroundColor="#EEF2F6">

    <NavigationPage.TitleView>
        <Grid Padding="0,0,16,0" VerticalOptions="Center">
            <Label Text="✍️ Take Manual Order"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center" />
        </Grid>
    </NavigationPage.TitleView>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="14">
                <!-- Header Banner -->
                <Border BackgroundColor="#7C3AED" StrokeThickness="0" Padding="18,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#307C3AED" Offset="0,4" Radius="10" Opacity="0.3" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="🍱 Admin Manual Order" FontSize="19" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Select an employee and choose items from today's menu to place an order on their behalf."
                               FontSize="12"
                               TextColor="#DDD6FE" />
                    </VerticalStackLayout>
                </Border>

                <!-- Section: Employee Selector -->
                <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#08000000" Offset="0,2" Radius="6" Opacity="0.08" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="👤 Select Employee *" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" />
                        <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" Padding="12,4">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Picker x:Name="EmployeePicker"
                                    Title="-- Select Registered Employee --"
                                    TitleColor="#94A3B8"
                                    TextColor="#0F172A"
                                    FontSize="14"
                                    ItemDisplayBinding="{Binding DisplayName}"
                                    SelectedIndexChanged="EmployeePicker_SelectedIndexChanged" />
                        </Border>
                        <Label x:Name="SelectedEmployeeInfoLabel"
                               FontSize="12"
                               TextColor="#7C3AED"
                               FontAttributes="Bold"
                               IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <!-- Section: Today's Menu -->
                <Grid ColumnDefinitions="*,Auto" Margin="2,4,2,-4">
                    <Label Grid.Column="0" Text="🍽️ Today's Available Menu" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                    <Label Grid.Column="1" x:Name="MenuDateBadgeLabel" Text="" FontSize="12" TextColor="#64748B" VerticalOptions="Center" />
                </Grid>

                <ActivityIndicator x:Name="MenuLoadingIndicator" IsRunning="True" Color="#7C3AED" HeightRequest="36" />

                <!-- No Menu Warning -->
                <Border x:Name="NoMenuBorder" BackgroundColor="White" StrokeThickness="0" Padding="20" IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="❌ Today's menu is not published yet" FontSize="14" FontAttributes="Bold" TextColor="#EF4444" HorizontalOptions="Center" />
                        <Label Text="Please create and publish today's menu before taking manual orders." FontSize="12" TextColor="#64748B" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Food Items List -->
                <VerticalStackLayout x:Name="FoodItemsListStack" Spacing="10" />

                <!-- Section: Special Instructions -->
                <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#08000000" Offset="0,2" Radius="6" Opacity="0.08" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="📝 Special Instructions (Optional)" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" />
                        <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" Padding="10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Editor x:Name="SpecialInstructionsEditor"
                                    Placeholder="e.g. Less spicy, extra salad, urgent..."
                                    PlaceholderColor="#94A3B8"
                                    TextColor="#0F172A"
                                    HeightRequest="70"
                                    FontSize="13"
                                    AutoSize="Disabled" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Sticky Bottom Summary Bar -->
        <Border Grid.Row="1" BackgroundColor="White" StrokeThickness="0" Padding="16,14">
            <Border.Shadow>
                <Shadow Brush="#20000000" Offset="0,-3" Radius="8" Opacity="0.15" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                    <Label Text="Total Amount:" FontSize="11" TextColor="#64748B" />
                    <Label x:Name="CartTotalLabel"
                           Text="Rs.0  (0 items)"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#7C3AED" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        x:Name="PlaceOrderButton"
                        Text="Place Order"
                        FontSize="15"
                        FontAttributes="Bold"
                        BackgroundColor="#9CA3AF"
                        TextColor="White"
                        CornerRadius="14"
                        HeightRequest="48"
                        Padding="20,0"
                        IsEnabled="False"
                        Clicked="PlaceOrderButton_Clicked" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
