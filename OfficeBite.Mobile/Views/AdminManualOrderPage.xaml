<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OfficeBite.Mobile.Views.AdminManualOrderPage"
             Title="Manual Order"
             BackgroundColor="#EEF2F6">

    <NavigationPage.TitleView>
        <Grid Padding="0,0,16,0" VerticalOptions="Center">
            <Label Text="✍️ Take Manual Order"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center" />
        </Grid>
    </NavigationPage.TitleView>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="14">
                <!-- Header Banner -->
                <Border BackgroundColor="#7C3AED" StrokeThickness="0" Padding="18,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#307C3AED" Offset="0,4" Radius="10" Opacity="0.3" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="🍱 Admin Manual Order" FontSize="19" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Enter employee name, select items or tap 'Add Item' to add items with custom prices."
                               FontSize="12"
                               TextColor="#DDD6FE" />
                    </VerticalStackLayout>
                </Border>

                <!-- Section 1: Employee Name Text Box -->
                <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#08000000" Offset="0,2" Radius="6" Opacity="0.08" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="👤 Employee Name *" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" />
                        <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1.5" Padding="12,4">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Entry x:Name="EmployeeNameEntry"
                                   Placeholder="Type Employee / Guest Name (e.g. Rahul Sharma)..."
                                   PlaceholderColor="#94A3B8"
                                   TextColor="#0F172A"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextChanged="EmployeeNameEntry_TextChanged" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Section 2: Today's Menu Dishes -->
                <Grid ColumnDefinitions="*,Auto" Margin="2,4,2,-4">
                    <Label Grid.Column="0" Text="🍽️ Today's Available Menu" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                    <Label Grid.Column="1" x:Name="MenuDateBadgeLabel" Text="" FontSize="12" TextColor="#64748B" VerticalOptions="Center" />
                </Grid>

                <ActivityIndicator x:Name="MenuLoadingIndicator" IsRunning="True" Color="#7C3AED" HeightRequest="36" />

                <!-- Food Items List -->
                <VerticalStackLayout x:Name="FoodItemsListStack" Spacing="10" />

                <!-- Section 3: Add Items -->
                <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#08000000" Offset="0,2" Radius="6" Opacity="0.08" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="➕ Add Items" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                                <Label Text="Add any items and enter item price" FontSize="11" TextColor="#64748B" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="➕ Add Item"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    BackgroundColor="#7C3AED"
                                    TextColor="White"
                                    CornerRadius="10"
                                    Padding="14,0"
                                    HeightRequest="38"
                                    Clicked="AddCustomDishButton_Clicked" />
                        </Grid>

                        <VerticalStackLayout x:Name="CustomDishesListStack" Spacing="10" />
                    </VerticalStackLayout>
                </Border>

                <!-- Section 4: Special Instructions -->
                <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#08000000" Offset="0,2" Radius="6" Opacity="0.08" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="📝 Special Instructions (Optional)" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" />
                        <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" Padding="10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Editor x:Name="SpecialInstructionsEditor"
                                    Placeholder="e.g. Less spicy, extra salad, urgent..."
                                    PlaceholderColor="#94A3B8"
                                    TextColor="#0F172A"
                                    HeightRequest="70"
                                    FontSize="13"
                                    AutoSize="Disabled" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Sticky Bottom Summary Bar -->
        <Border Grid.Row="1" BackgroundColor="White" StrokeThickness="0" Padding="16,14">
            <Border.Shadow>
                <Shadow Brush="#20000000" Offset="0,-3" Radius="8" Opacity="0.15" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                    <Label Text="Total Amount:" FontSize="11" TextColor="#64748B" />
                    <Label x:Name="CartTotalLabel"
                           Text="Rs.0  (0 items)"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#7C3AED" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        x:Name="PlaceOrderButton"
                        Text="Place Order"
                        FontSize="15"
                        FontAttributes="Bold"
                        BackgroundColor="#9CA3AF"
                        TextColor="White"
                        CornerRadius="14"
                        HeightRequest="48"
                        Padding="20,0"
                        IsEnabled="False"
                        Clicked="PlaceOrderButton_Clicked" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
