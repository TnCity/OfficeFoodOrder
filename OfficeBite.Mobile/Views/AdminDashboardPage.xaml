<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OfficeBite.Mobile.Views.AdminDashboardPage"
             Title="Admin Panel"
             BackgroundColor="#EEF2F6">

    <NavigationPage.TitleView>
        <Grid ColumnDefinitions="*,Auto" Padding="0,0,12,0" VerticalOptions="Center">
            <Label Grid.Column="0" Text="Mr. Sanjeeb" FontSize="18" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Logout"
                    FontSize="13"
                    FontAttributes="Bold"
                    BackgroundColor="#5B21B6"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="34"
                    Padding="12,0"
                    Clicked="LogoutButton_Clicked" />
        </Grid>
    </NavigationPage.TitleView>

    <RefreshView x:Name="RefreshView" Refreshing="OnRefreshing" RefreshColor="#7C3AED">
        <ScrollView>
            <VerticalStackLayout Padding="16,16,16,24" Spacing="16">
                <!-- Welcome Banner -->
                <Border BackgroundColor="#7C3AED" StrokeThickness="0" Padding="20,18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#307C3AED" Offset="0,4" Radius="10" Opacity="0.3" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="🍱 Food Order Management" FontSize="20" FontAttributes="Bold" TextColor="White" />
                        <Label x:Name="DateLabel" FontSize="12" TextColor="#DDD6FE" />
                    </VerticalStackLayout>
                </Border>

                <!-- Quick Action Buttons -->
                <Label Text="⚡ Actions" FontSize="17" FontAttributes="Bold" TextColor="#0F172A" Margin="2,0,0,-6" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Button Grid.Row="0" Grid.Column="0"
                            Text="🍽️ Daily Menu&#10;(Active / InActive)"
                            FontSize="13"
                            FontAttributes="Bold"
                            HeightRequest="64"
                            CornerRadius="14"
                            BackgroundColor="#7C3AED"
                            TextColor="White"
                            Clicked="CreateMenuButton_Clicked" />

                    <Button Grid.Row="0" Grid.Column="1"
                            Text="📋 Orders List&#10;(View Live Orders)"
                            FontSize="13"
                            FontAttributes="Bold"
                            HeightRequest="64"
                            CornerRadius="14"
                            BackgroundColor="#0284C7"
                            TextColor="White"
                            Clicked="ViewOrdersButton_Clicked" />

                    <Button Grid.Row="1" Grid.Column="0"
                            Text="📊 Order Summary&#10;(Totals &amp; PDF)"
                            FontSize="13"
                            FontAttributes="Bold"
                            HeightRequest="64"
                            CornerRadius="14"
                            BackgroundColor="#6D28D9"
                            TextColor="White"
                            Clicked="OrderSummaryButton_Clicked" />

                    <!-- For Manual Order -->
                    <Button Grid.Row="1" Grid.Column="1"
                            Text="✍️ Manual Order&#10;(For Employee)"
                            FontSize="13"
                            FontAttributes="Bold"
                            HeightRequest="64"
                            CornerRadius="14"
                            BackgroundColor="#059669"
                            TextColor="White"
                            Clicked="ManualOrderButton_Clicked" />
                </Grid>

                <!-- Section: Today's Summary -->
                <Label Text="📊 Today's Order Stats" FontSize="17" FontAttributes="Bold" TextColor="#0F172A" Margin="2,6,0,-6" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <!-- Total Orders -->
                    <Border Grid.Row="0" Grid.Column="0" BackgroundColor="White" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Total Orders" FontSize="12" TextColor="#64748B" />
                            <Label x:Name="TotalOrdersLabel" Text="0" FontSize="26" FontAttributes="Bold" TextColor="#0F172A" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Revenue -->
                    <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#F5F3FF" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Total Revenue" FontSize="12" TextColor="#7C3AED" />
                            <Label x:Name="TotalAmountLabel" Text="Rs.0" FontSize="22" FontAttributes="Bold" TextColor="#7C3AED" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Pending (New) -->
                    <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#FEF3C7" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="⏳ Pending" FontSize="12" TextColor="#B45309" />
                            <Label x:Name="PendingLabel" Text="0" FontSize="26" FontAttributes="Bold" TextColor="#B45309" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Confirmed -->
                    <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#EFF6FF" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="👍 Confirmed" FontSize="12" TextColor="#1D4ED8" />
                            <Label x:Name="ConfirmedLabel" Text="0" FontSize="26" FontAttributes="Bold" TextColor="#1D4ED8" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Delivered -->
                    <Border Grid.Row="2" Grid.Column="0" BackgroundColor="#ECFDF5" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="✅ Delivered" FontSize="12" TextColor="#047857" />
                            <Label x:Name="DeliveredLabel" Text="0" FontSize="26" FontAttributes="Bold" TextColor="#047857" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Cancelled -->
                    <Border Grid.Row="2" Grid.Column="1" BackgroundColor="#FEF2F2" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="❌ Cancelled" FontSize="12" TextColor="#DC2626" />
                            <Label x:Name="CancelledLabel" Text="0" FontSize="26" FontAttributes="Bold" TextColor="#DC2626" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Section: Food Quantities to Prepare --><!--
                <Label Text="🍳 Total Food Items to Cook Today" FontSize="17" FontAttributes="Bold" TextColor="#0F172A" Margin="2,6,0,-6" />
                <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <VerticalStackLayout x:Name="FoodSummaryStack" Spacing="8">
                        <Label Text="No food orders placed yet" FontSize="13" TextColor="#94A3B8" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>-->

                <!-- Section: Today's Orders from Employees (Live with Name & Total Price) -->
                <Grid ColumnDefinitions="*,Auto" Margin="2,10,2,-4">
                    <Label Grid.Column="0" Text="📦 Today's Employee Orders" FontSize="17" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                    <Label Grid.Column="1" x:Name="LiveOrdersCountLabel" Text="0 orders" FontSize="12" FontAttributes="Bold" TextColor="#7C3AED" VerticalOptions="Center" />
                </Grid>

                <Border x:Name="NoLiveOrdersBorder" BackgroundColor="White" StrokeThickness="0" Padding="20" IsVisible="True">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Label Text="No employee orders placed yet today" FontSize="13" TextColor="#94A3B8" HorizontalOptions="Center" />
                </Border>

                <VerticalStackLayout x:Name="LiveOrdersStack" Spacing="10" IsVisible="False" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>