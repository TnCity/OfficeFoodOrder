<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OfficeBite.Mobile.Views.LoginPage"
             Title="Login"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#EEF2F6">
    <ScrollView>
        <VerticalStackLayout Padding="24,40,24,24" Spacing="20">
            <!-- App Header -->
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                <Image Source="app_logo.png" HeightRequest="110" WidthRequest="110" HorizontalOptions="Center" Aspect="AspectFit" />
                <Label Text="Office Lunch Ordering" FontSize="14" HorizontalOptions="Center" TextColor="#64748B" Margin="0,2,0,0" />
            </VerticalStackLayout>

            <!-- Login Card -->
            <Border BackgroundColor="White" StrokeThickness="0" Padding="24,28">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#10000000" Offset="0,4" Radius="12" Opacity="0.1" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">
                    <Label Text="Welcome Back" FontSize="22" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="Please sign in to continue" FontSize="13" TextColor="#64748B" Margin="0,-10,0,8" />

                    <!-- Email Field -->
                    <Label Text="Email Address" FontSize="13" FontAttributes="Bold" TextColor="#334155" />
                    <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="12,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="EmailEntry"
                               Placeholder="your.email@office.com"
                               Keyboard="Email"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8"
                               ClearButtonVisibility="WhileEditing"
                               HeightRequest="48" />
                    </Border>

                    <!-- Password Field -->
                    <Label Text="Password" FontSize="13" FontAttributes="Bold" TextColor="#334155" Margin="0,4,0,0" />
                    <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="12,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="PasswordEntry"
                               Placeholder="Enter password"
                               IsPassword="True"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8"
                               ClearButtonVisibility="WhileEditing"
                               HeightRequest="48" />
                    </Border>

                    <!-- Error Message -->
                    <Border x:Name="ErrorBorder" BackgroundColor="#FEF2F2" Stroke="#FCA5A5" StrokeThickness="1" Padding="12,8" IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Label x:Name="ErrorLabel" TextColor="#DC2626" FontSize="13" />
                    </Border>

                    <!-- Login Button -->
                    <Button x:Name="LoginButton"
                            Text="Sign In"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="52"
                            CornerRadius="12"
                            BackgroundColor="#4F46E5"
                            TextColor="White"
                            Clicked="LoginButton_Clicked"
                            Margin="0,8,0,0" />

                    <ActivityIndicator x:Name="LoadingIndicator"
                                       IsVisible="False"
                                       IsRunning="False"
                                       Color="#4F46E5"
                                       HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- New Employee Registration Card -->
            <Border BackgroundColor="White" StrokeThickness="0" Padding="16,14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#08000000" Offset="0,2" Radius="8" Opacity="0.06" />
                </Border.Shadow>
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label Text="New Employee?" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" />
                        <Label Text="Register for a food ordering account" FontSize="12" TextColor="#64748B" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="Register →"
                            FontSize="13"
                            FontAttributes="Bold"
                            BackgroundColor="#EEF2FF"
                            TextColor="#4F46E5"
                            CornerRadius="10"
                            HeightRequest="38"
                            Padding="12,0"
                            Clicked="RegisterButton_Clicked" />
                </Grid>
            </Border>

            <!-- Quick Login for Easy Access -->
            <Border BackgroundColor="#F1F5F9" StrokeThickness="0" Padding="16,14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="⚡ Quick Sign In (Demo):" FontSize="12" FontAttributes="Bold" TextColor="#475569" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="👑 Sandeep (Admin)"
                                FontSize="12"
                                FontAttributes="Bold"
                                HeightRequest="38"
                                CornerRadius="8"
                                BackgroundColor="#7C3AED"
                                TextColor="White"
                                Clicked="QuickAdmin_Clicked" />
                        <Button Grid.Column="1"
                                Text="👤 Employee"
                                FontSize="12"
                                FontAttributes="Bold"
                                HeightRequest="38"
                                CornerRadius="8"
                                BackgroundColor="#0284C7"
                                TextColor="White"
                                Clicked="QuickEmployee_Clicked" />
                        
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>