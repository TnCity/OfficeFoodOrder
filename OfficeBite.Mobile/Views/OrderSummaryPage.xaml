<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OfficeBite.Mobile.Views.OrderSummaryPage"
             Title="Today's Order Summary"
             BackgroundColor="#EEF2F6">

    <NavigationPage.TitleView>
        <Grid ColumnDefinitions="*,Auto" Padding="0,0,12,0" VerticalOptions="Center">
            <Label Grid.Column="0" Text="Order Summary" FontSize="17" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="📄 PDF"
                    FontSize="12"
                    FontAttributes="Bold"
                    BackgroundColor="#5B21B6"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="32"
                    Padding="10,0"
                    Clicked="DownloadPdfButton_Clicked" />
        </Grid>
    </NavigationPage.TitleView>

    <RefreshView x:Name="RefreshView" Refreshing="OnRefreshing" RefreshColor="#7C3AED">
        <ScrollView>
            <VerticalStackLayout Padding="16,16,16,28" Spacing="16">

                <!-- Welcome / Action Banner -->
                <Border BackgroundColor="#7C3AED" StrokeThickness="0" Padding="18,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#307C3AED" Offset="0,4" Radius="10" Opacity="0.3" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="📊 Today's Total Summary" FontSize="19" FontAttributes="Bold" TextColor="White" />
                                <Label x:Name="DateLabel" FontSize="12" TextColor="#DDD6FE" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- PDF Actions inside banner -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <Button Grid.Column="0"
                                    Text="📥 Open PDF"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    HeightRequest="42"
                                    CornerRadius="10"
                                    BackgroundColor="White"
                                    TextColor="#6D28D9"
                                    Clicked="DownloadPdfButton_Clicked" />

                            <Button Grid.Column="1"
                                    Text="📤 Share PDF"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    HeightRequest="42"
                                    CornerRadius="10"
                                    BackgroundColor="#5B21B6"
                                    TextColor="White"
                                    BorderColor="#DDD6FE"
                                    BorderWidth="1"
                                    Clicked="SharePdfButton_Clicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Activity Indicator -->
                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="True" IsVisible="True" Color="#7C3AED" HorizontalOptions="Center" Margin="0,20" />

                <!-- Content Container (hidden while loading) -->
                <VerticalStackLayout x:Name="MainContentStack" Spacing="16" IsVisible="False">

                    <!-- Stats 2x2 Grid -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <!-- Total Orders -->
                        <Border Grid.Row="0" Grid.Column="0" BackgroundColor="White" StrokeThickness="0" Padding="14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Total Orders" FontSize="11" TextColor="#64748B" FontAttributes="Bold" />
                                <Label x:Name="TotalOrdersLabel" Text="0" FontSize="24" FontAttributes="Bold" TextColor="#0F172A" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Total Items to Cook -->
                        <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#F5F3FF" StrokeThickness="0" Padding="14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Items to Cook" FontSize="11" TextColor="#7C3AED" FontAttributes="Bold" />
                                <Label x:Name="TotalItemsLabel" Text="0" FontSize="24" FontAttributes="Bold" TextColor="#7C3AED" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Revenue -->
                        <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#ECFDF5" StrokeThickness="0" Padding="14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Total Revenue" FontSize="11" TextColor="#047857" FontAttributes="Bold" />
                                <Label x:Name="TotalAmountLabel" Text="Rs.0" FontSize="20" FontAttributes="Bold" TextColor="#047857" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Status Breakdown -->
                        <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#EFF6FF" StrokeThickness="0" Padding="14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Status" FontSize="11" TextColor="#1D4ED8" FontAttributes="Bold" />
                                <Label x:Name="StatusBreakdownLabel" Text="0 Conf | 0 Pend" FontSize="14" FontAttributes="Bold" TextColor="#1D4ED8" VerticalOptions="Center" Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- SECTION 1: FOOD ITEMS PREPARATION SUMMARY (COOKING LIST) -->
                    <Grid ColumnDefinitions="*,Auto" Margin="2,4,2,-6">
                        <Label Grid.Column="0" Text="🍳 Items to Cook Today" FontSize="17" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                        <Label Grid.Column="1" x:Name="FoodItemsCountLabel" Text="0 items" FontSize="12" FontAttributes="Bold" TextColor="#7C3AED" VerticalOptions="Center" />
                    </Grid>

                    <Border x:Name="NoFoodItemsBorder" BackgroundColor="White" StrokeThickness="0" Padding="20" IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Label Text="No food items ordered yet today." FontSize="13" TextColor="#94A3B8" HorizontalOptions="Center" />
                    </Border>

                    <!-- Food Items Stack -->
                    <VerticalStackLayout x:Name="FoodItemsStack" Spacing="10" />

                    <!-- SECTION 2: INDIVIDUAL EMPLOYEE ORDERS -->
                    <Grid ColumnDefinitions="*,Auto" Margin="2,10,2,-6">
                        <Label Grid.Column="0" Text="📋 Orders by Employee" FontSize="17" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                        <Label Grid.Column="1" x:Name="OrdersCountLabel" Text="0 orders" FontSize="12" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center" />
                    </Grid>

                    <Border x:Name="NoOrdersBorder" BackgroundColor="White" StrokeThickness="0" Padding="20" IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Label Text="No employee orders placed yet today." FontSize="13" TextColor="#94A3B8" HorizontalOptions="Center" />
                    </Border>

                    <!-- Employee Orders Stack -->
                    <VerticalStackLayout x:Name="EmployeeOrdersStack" Spacing="10" />

                    <!-- Bottom PDF Button -->
                    <Button Text="📄 Export &amp; View PDF Summary"
                            FontSize="15"
                            FontAttributes="Bold"
                            HeightRequest="52"
                            CornerRadius="14"
                            BackgroundColor="#7C3AED"
                            TextColor="White"
                            Margin="0,10,0,0"
                            Clicked="DownloadPdfButton_Clicked" />

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
