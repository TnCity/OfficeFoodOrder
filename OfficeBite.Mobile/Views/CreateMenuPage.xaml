<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OfficeBite.Mobile.Views.CreateMenuPage"
             Title="Manage Menu"
             BackgroundColor="#EEF2F6">

    <NavigationPage.TitleView>
        <Grid Padding="0,0,16,0" VerticalOptions="Center">
            <Label
        Text="Manage Today's Menu"
        FontSize="17"
        FontAttributes="Bold"
        TextColor="White"
        VerticalOptions="Center" />
        </Grid>
    </NavigationPage.TitleView>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- Status Banner if menu exists -->
                <Border x:Name="ExistingMenuBanner" BackgroundColor="#DCFCE7" StrokeThickness="0" Padding="14,12" IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label x:Name="BannerTitleLabel" Text="✅ Today's Menu Created" FontSize="14" FontAttributes="Bold" TextColor="#15803D" />
                            <Label x:Name="ExistingMenuLabel" FontSize="12" TextColor="#166534" />
                        </VerticalStackLayout>
                        <Button Grid.Row="0" Grid.Column="1"
                                x:Name="PublishButton"
                                Text="🚀 Publish"
                                FontSize="13"
                                FontAttributes="Bold"
                                HeightRequest="38"
                                CornerRadius="10"
                                BackgroundColor="#16A34A"
                                TextColor="White"
                                IsVisible="False"
                                Clicked="PublishButton_Clicked" />
                    </Grid>
                </Border>

                <!-- Already Saved Items Section (Shown when menu exists) -->
                <VerticalStackLayout x:Name="SavedItemsSection" Spacing="8" IsVisible="False">
                    <Label x:Name="SavedItemsHeader"
                           Text="📋 Saved Menu Items"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#334155" />
                    <VerticalStackLayout x:Name="SavedItemsStack" Spacing="6" />
                </VerticalStackLayout>

                <!-- New Food Items Header & Add Button -->
                <Grid ColumnDefinitions="*,Auto" Margin="2,6,2,0">
                    <Label x:Name="AddItemsHeaderLabel"
                           Grid.Column="0"
                           Text=" Add Food Items"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="+ Add Item"
                            FontSize="13"
                            FontAttributes="Bold"
                            HeightRequest="36"
                            CornerRadius="10"
                            BackgroundColor="#EDE9FE"
                            TextColor="#7C3AED"
                            Clicked="AddItemButton_Clicked" />
                </Grid>

                <!-- Dynamic Item Rows to Add -->
                <VerticalStackLayout x:Name="FoodItemsStack" Spacing="10" />

                <!-- Empty Placeholder -->
                <Border x:Name="NoItemsPlaceholder" BackgroundColor="White" StrokeThickness="0" Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Label Text="Tap '+ Add Item' to add new food items"
                           FontSize="13"
                           TextColor="#94A3B8"
                           HorizontalOptions="Center" />
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Save Button Sticky Footer -->
        <Border Grid.Row="1" BackgroundColor="White" StrokeThickness="0" Padding="16,14">
            <Border.Shadow>
                <Shadow Brush="#15000000" Offset="0,-3" Radius="10" Opacity="0.1" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="8">
                <ActivityIndicator x:Name="LoadingIndicator" IsVisible="False" IsRunning="False" Color="#7C3AED" HorizontalOptions="Center" />
                <Button x:Name="SaveMenuButton"
                        Text="💾 Save Menu"
                        FontSize="15"
                        FontAttributes="Bold"
                        HeightRequest="52"
                        CornerRadius="14"
                        BackgroundColor="#7C3AED"
                        TextColor="White"
                        Clicked="SaveMenuButton_Clicked" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>