<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OfficeBite.Mobile.Views.CreateMenuPage"
             Title="Manage Daily Menu"
             BackgroundColor="#EEF2F6">

    <NavigationPage.TitleView>
        <Grid ColumnDefinitions="*,Auto" Padding="0,0,14,0" VerticalOptions="Center">
            <Label Grid.Column="0"
                   Text="🍽️ Manage Daily Menu"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="🔄 Reset 19 Items"
                    FontSize="11"
                    FontAttributes="Bold"
                    BackgroundColor="#581C87"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="32"
                    Padding="8,0"
                    Clicked="ResetStandardButton_Clicked" />
        </Grid>
    </NavigationPage.TitleView>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- Status Banner for Today's Menu -->
                <Border x:Name="ExistingMenuBanner" BackgroundColor="#DCFCE7" StrokeThickness="0" Padding="14,12" IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label x:Name="BannerTitleLabel" Text="🟢 Today's Menu is Live" FontSize="14" FontAttributes="Bold" TextColor="#15803D" />
                            <Label x:Name="ExistingMenuLabel" Text="All active items are visible to employees" FontSize="12" TextColor="#166534" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                x:Name="PublishButton"
                                Text="🚀 Publish"
                                FontSize="12"
                                FontAttributes="Bold"
                                HeightRequest="36"
                                CornerRadius="8"
                                BackgroundColor="#16A34A"
                                TextColor="White"
                                Padding="12,0"
                                IsVisible="False"
                                Clicked="PublishButton_Clicked" />
                    </Grid>
                </Border>

                <!-- Search Bar for Admin -->
                <Border BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Text="🔍" FontSize="15" VerticalOptions="Center" Margin="0,0,8,0" />
                        <Entry Grid.Column="1"
                               x:Name="AdminSearchEntry"
                               Placeholder="Search menu items to edit / toggle..."
                               FontSize="13"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8"
                               ClearButtonVisibility="WhileEditing"
                               HeightRequest="42"
                               TextChanged="AdminSearchEntry_TextChanged" />
                    </Grid>
                </Border>

                <!-- Saved Menu Items Section -->
                <VerticalStackLayout x:Name="SavedItemsSection" Spacing="10" IsVisible="False">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="SavedItemsHeader"
                               Grid.Column="0"
                               Text="📋 Daily Menu Items"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#0F172A"
                               VerticalOptions="Center" />
                        <Label x:Name="ActiveCountSummaryLabel"
                               Grid.Column="1"
                               Text="19 Active"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#16A34A"
                               VerticalOptions="Center" />
                    </Grid>

                    <Label Text="💡 Tip: Mark an item 'Inactive' if not available today. Inactive items will NOT be shown to employees."
                           FontSize="11"
                           TextColor="#64748B"
                           Margin="2,-4,0,2" />

                    <!-- List of current items with Active/Inactive and Edit buttons -->
                    <VerticalStackLayout x:Name="SavedItemsStack" Spacing="8" />
                </VerticalStackLayout>

                <!-- New Food Items Header & Add Button -->
                <Grid ColumnDefinitions="*,Auto" Margin="2,10,2,0">
                    <Label x:Name="AddItemsHeaderLabel"
                           Grid.Column="0"
                           Text="➕ Add New Custom Item"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="+ Add Row"
                            FontSize="12"
                            FontAttributes="Bold"
                            HeightRequest="34"
                            CornerRadius="8"
                            BackgroundColor="#EDE9FE"
                            TextColor="#7C3AED"
                            Clicked="AddItemButton_Clicked" />
                </Grid>

                <!-- Dynamic Item Rows to Add -->
                <VerticalStackLayout x:Name="FoodItemsStack" Spacing="10" />

                <!-- Empty Placeholder -->
                <Border x:Name="NoItemsPlaceholder" BackgroundColor="White" StrokeThickness="0" Padding="16" IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label Text="All standard items are managed above. Tap '+ Add Row' to add custom items."
                           FontSize="12"
                           TextColor="#94A3B8"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Save Button Sticky Footer (only enabled when adding new items or saving changes) -->
        <Border Grid.Row="1" x:Name="SaveFooterBorder" BackgroundColor="White" StrokeThickness="0" Padding="16,12" IsVisible="False">
            <Border.Shadow>
                <Shadow Brush="#15000000" Offset="0,-3" Radius="10" Opacity="0.1" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="6">
                <ActivityIndicator x:Name="LoadingIndicator" IsVisible="False" IsRunning="False" Color="#7C3AED" HorizontalOptions="Center" />
                <Button x:Name="SaveMenuButton"
                        Text="💾 Save New Added Items"
                        FontSize="14"
                        FontAttributes="Bold"
                        HeightRequest="46"
                        CornerRadius="12"
                        BackgroundColor="#7C3AED"
                        TextColor="White"
                        Clicked="SaveMenuButton_Clicked" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>