<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OfficeBite.Mobile.Views.OrderHistoryPage"
             Title="Order History"
             BackgroundColor="#EEF2F6">

    <NavigationPage.TitleView>
        <Grid Padding="0,0,16,0" VerticalOptions="Center">
            <Label Text="My Order History"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center" />
        </Grid>
    </NavigationPage.TitleView>

    <RefreshView x:Name="RefreshView" Refreshing="OnRefreshing" RefreshColor="#4F46E5">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">
                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="True" IsVisible="True" Color="#4F46E5" HorizontalOptions="Center" Margin="0,40" />

                <!-- Empty State -->
                <Border x:Name="NoOrdersBorder" BackgroundColor="White" StrokeThickness="0" Padding="32" IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="🍽️" FontSize="36" HorizontalOptions="Center" />
                        <Label Text="No Orders Yet" FontSize="17" FontAttributes="Bold" TextColor="#1E293B" HorizontalOptions="Center" />
                        <Label Text="When you place lunch orders, they will show up here." FontSize="13" TextColor="#64748B" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Order List -->
                <CollectionView x:Name="OrdersCollection" SelectionMode="None" IsVisible="False">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="White" StrokeThickness="0" Padding="16" Margin="0,0,0,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#08000000" Offset="0,2" Radius="6" Opacity="0.08" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="10">
                                    <!-- Order Header -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Border Grid.Column="0" BackgroundColor="{Binding StatusColor}" StrokeThickness="0" Padding="10,4" HorizontalOptions="Start">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding StatusEmoji}" FontSize="12" FontAttributes="Bold" TextColor="White" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding TotalDisplay}" FontSize="17" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                                    </Grid>

                                    <!-- Items List -->
                                    <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto" Padding="0,3">
                                                    <Label Grid.Column="0" Text="{Binding Display}" FontSize="14" TextColor="#334155" />
                                                    <Label Grid.Column="1" Text="{Binding PriceDisplay}" FontSize="14" TextColor="#64748B" />
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>

                                    <BoxView HeightRequest="1" Color="#F1F5F9" />
                                    <Label Text="{Binding CreatedAt}" FontSize="11" TextColor="#94A3B8" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>