<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OfficeBite.Mobile.Views.OrderHistoryPage"
             Title="My Orders"
             BackgroundColor="#EEF2F6">

    <NavigationPage.TitleView>
        <Grid ColumnDefinitions="*,Auto" Padding="0,0,12,0" VerticalOptions="Center">
            <Label Grid.Column="0"
                   Text="📋 My Orders"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center" />
            <Border Grid.Column="1"
                    BackgroundColor="#312E81"
                    StrokeThickness="0"
                    Padding="10,4"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Label Text="⚡ Live Sync" FontSize="11" FontAttributes="Bold" TextColor="#A5B4FC" />
            </Border>
        </Grid>
    </NavigationPage.TitleView>

    <RefreshView x:Name="RefreshView" Refreshing="OnRefreshing" RefreshColor="#4F46E5">
        <ScrollView>
            <VerticalStackLayout Padding="16,16,16,24" Spacing="16">
                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="True" IsVisible="True" Color="#4F46E5" HorizontalOptions="Center" Margin="0,40" />

                <!-- Empty State -->
                <Border x:Name="NoOrdersBorder" BackgroundColor="White" StrokeThickness="0" Padding="32" IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="🍽️" FontSize="36" HorizontalOptions="Center" />
                        <Label Text="No Orders Found" FontSize="17" FontAttributes="Bold" TextColor="#1E293B" HorizontalOptions="Center" />
                        <Label Text="When you place lunch orders, they will show up here with live status updates." FontSize="13" TextColor="#64748B" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Section: Today's Orders (Live) -->
                <VerticalStackLayout x:Name="TodayOrdersSection" Spacing="12" IsVisible="False">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="📦 Today's Live Order" FontSize="17" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                        <Label Grid.Column="1" x:Name="TodayOrdersCountLabel" Text="1 order" FontSize="12" FontAttributes="Bold" TextColor="#4F46E5" VerticalOptions="Center" />
                    </Grid>
                    <VerticalStackLayout x:Name="TodayOrdersStack" Spacing="12" />
                </VerticalStackLayout>

                <!-- Section: Past Orders History -->
                <VerticalStackLayout x:Name="PastOrdersSection" Spacing="12" IsVisible="False">
                    <Label Text="📜 Past Orders History" FontSize="16" FontAttributes="Bold" TextColor="#475569" Margin="0,8,0,0" />
                    <VerticalStackLayout x:Name="PastOrdersStack" Spacing="10" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>