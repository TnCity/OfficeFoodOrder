@model OfficeBite.API.Controllers.EditOrderViewModel
@{
    ViewData["Title"] = $"Edit Order #{Model.Order.OrderId}";
    var availableItems = Model.Menu.Items.Where(i => i.IsAvailable).ToList();
}

<div style="max-width: 800px; margin: 1.5rem auto;">
    <div style="margin-bottom: 1.5rem;">
        <a href="/web/orders/details/@Model.Order.OrderId" style="color: #64748b; text-decoration: none; font-weight: 600; font-size: 0.9rem;">
            ← Back to Order Details
        </a>
    </div>

    <div style="background: white; border-radius: 16px; border: 1px solid #e2e8f0; padding: 2rem; box-shadow: 0 4px 25px rgba(0, 0, 0, 0.05);">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #f1f5f9; padding-bottom: 1rem; margin-bottom: 1.5rem;">
            <div>
                <h1 style="font-size: 1.5rem; font-weight: 800; color: #0f172a;">✏️ Edit Order #@Model.Order.OrderId</h1>
                <p style="color: #64748b; font-size: 0.875rem; margin-top: 0.25rem;">Modify portion quantities or special notes for today's lunch.</p>
            </div>
            <span class="badge badge-pending">PENDING</span>
        </div>

        <form asp-action="Edit" asp-route-id="@Model.Order.OrderId" method="post" id="editOrderForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="MenuId" value="@Model.Menu.MenuId" />

            <div style="border: 1px solid #f1f5f9; border-radius: 12px; overflow: hidden; margin-bottom: 1.5rem;">
                <div style="padding: 0.9rem 1.25rem; background: #f8fafc; font-weight: 700; color: #475569; font-size: 0.85rem; text-transform: uppercase;">
                    Select Dishes & Quantities
                </div>

                <div style="display: flex; flex-direction: column;">
                    @for (int i = 0; i < availableItems.Count; i++)
                    {
                        var item = availableItems[i];
                        int initialQty = Model.CurrentItemQuantities.ContainsKey(item.MenuItemId) ? Model.CurrentItemQuantities[item.MenuItemId] : 0;

                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.25rem; border-bottom: 1px solid #f8fafc;">
                            <div>
                                <div style="font-weight: 700; font-size: 0.95rem; color: #0f172a;">@item.FoodName</div>
                                <div style="font-weight: 800; font-size: 0.9rem; color: #f97316; margin-top: 0.2rem;">₹@item.Price.ToString("N2")</div>
                            </div>

                            <div style="display: flex; align-items: center; gap: 0.5rem; background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 10px; padding: 0.25rem 0.5rem;">
                                <input type="hidden" name="Items[@i].MenuItemId" value="@item.MenuItemId" />

                                <button type="button" onclick="adjustEditQty(@i, -1, @item.Price)" 
                                        style="width: 28px; height: 28px; border-radius: 6px; border: 1px solid #cbd5e1; background: white; font-weight: 800; cursor: pointer;">
                                    −
                                </button>

                                <input type="number" id="edit_qty_@i" name="Items[@i].Quantity" value="@initialQty" min="0" max="20" readonly
                                       style="width: 36px; text-align: center; border: none; background: transparent; font-weight: 800; font-size: 0.95rem; color: #0f172a;" />

                                <button type="button" onclick="adjustEditQty(@i, 1, @item.Price)" 
                                        style="width: 28px; height: 28px; border-radius: 6px; border: none; background: #f97316; font-weight: 800; cursor: pointer; color: white;">
                                    +
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Summary Box -->
            <div style="background: #fff7ed; border: 1px solid #fed7aa; border-radius: 12px; padding: 1.25rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <div style="font-size: 0.85rem; color: #9a3412; font-weight: 700;">New Total Portions: <strong id="editTotalPortions">0</strong></div>
                    <div style="font-size: 1.25rem; font-weight: 800; color: #ea580c; margin-top: 0.25rem;">
                        Updated Total: <span id="editTotalPrice">₹0.00</span>
                    </div>
                </div>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; font-weight: 600; font-size: 0.85rem; color: #334155; margin-bottom: 0.4rem;">Special Instructions</label>
                <textarea name="SpecialInstructions" rows="2" placeholder="e.g. Less spicy, keep separate..." 
                          style="width: 100%; padding: 0.75rem 1rem; border-radius: 10px; border: 1px solid #cbd5e1; font-size: 0.9rem; outline: none;">@Model.Order.SpecialInstructions</textarea>
            </div>

            <div style="display: flex; gap: 1rem;">
                <button type="submit" id="saveEditBtn" class="btn btn-primary" style="flex: 1; padding: 0.85rem; font-size: 1rem; font-weight: 800;">
                    Save Order Changes
                </button>
                <a href="/web/orders/details/@Model.Order.OrderId" class="btn btn-secondary" style="padding: 0.85rem 1.5rem;">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const editPrices = {};
        const editQtys = {};

        @for (int i = 0; i < availableItems.Count; i++)
        {
            var it = availableItems[i];
            int q = Model.CurrentItemQuantities.ContainsKey(it.MenuItemId) ? Model.CurrentItemQuantities[it.MenuItemId] : 0;
            <text>
            editPrices[@i] = @it.Price;
            editQtys[@i] = @q;
            </text>
        }

        function adjustEditQty(index, delta, price) {
            let current = editQtys[index] || 0;
            let next = current + delta;
            if (next < 0) next = 0;
            if (next > 20) next = 20;

            editQtys[index] = next;
            const input = document.getElementById('edit_qty_' + index);
            if (input) input.value = next;

            calculateEditTotal();
        }

        function calculateEditTotal() {
            let totalQty = 0;
            let grandTotal = 0;

            for (let idx in editQtys) {
                let q = editQtys[idx];
                let p = editPrices[idx] || 0;
                totalQty += q;
                grandTotal += (q * p);
            }

            const totalPortions = document.getElementById('editTotalPortions');
            const totalPrice = document.getElementById('editTotalPrice');
            const saveBtn = document.getElementById('saveEditBtn');

            if (totalPortions) totalPortions.innerText = totalQty + (totalQty === 1 ? ' portion' : ' portions');
            if (totalPrice) totalPrice.innerText = '₹' + grandTotal.toFixed(2);

            if (saveBtn) {
                saveBtn.disabled = totalQty <= 0;
            }
        }

        // Initial calculation on load
        calculateEditTotal();
    </script>
}
