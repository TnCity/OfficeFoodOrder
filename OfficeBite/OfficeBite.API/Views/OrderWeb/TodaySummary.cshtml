@model OfficeBite.Shared.DTOs.TodayOrderSummaryDto
@{
    ViewData["Title"] = "Today's Order Summary";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
        <h1 style="font-size: 1.75rem; font-weight: 800; color: #0f172a;">Today's Kitchen & Order Summary</h1>
        <p style="color: #64748b; font-size: 0.95rem; margin-top: 0.25rem;">Live kitchen preparation count for @Model.Date.ToString("dddd, MMMM dd, yyyy")</p>
    </div>
    
    <div style="display: flex; gap: 0.5rem;">
        <a href="/web/orders?filter=today" class="btn btn-secondary btn-sm">📋 Today's Order List</a>
        <a href="/web/orders" class="btn btn-secondary btn-sm">All Orders</a>
    </div>
</div>

<!-- Stat KPI Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
    <div style="background: white; border-radius: 14px; border: 1px solid #e2e8f0; padding: 1.25rem; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
        <div style="color: #64748b; font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">Total Orders</div>
        <div style="font-size: 1.75rem; font-weight: 800; color: #0f172a; margin-top: 0.35rem;">@Model.TotalOrders</div>
    </div>
    
    <div style="background: white; border-radius: 14px; border: 1px solid #fed7aa; background: #fff7ed; padding: 1.25rem;">
        <div style="color: #c2410c; font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">Pending</div>
        <div style="font-size: 1.75rem; font-weight: 800; color: #ea580c; margin-top: 0.35rem;">@Model.PendingOrders</div>
    </div>

    <div style="background: white; border-radius: 14px; border: 1px solid #bae6fd; background: #f0f9ff; padding: 1.25rem;">
        <div style="color: #0369a1; font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">Confirmed</div>
        <div style="font-size: 1.75rem; font-weight: 800; color: #0284c7; margin-top: 0.35rem;">@Model.ConfirmedOrders</div>
    </div>

    <div style="background: white; border-radius: 14px; border: 1px solid #bbf7d0; background: #f0fdf4; padding: 1.25rem;">
        <div style="color: #15803d; font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">Delivered</div>
        <div style="font-size: 1.75rem; font-weight: 800; color: #16a34a; margin-top: 0.35rem;">@Model.DeliveredOrders</div>
    </div>

    <div style="background: white; border-radius: 14px; border: 1px solid #e2e8f0; padding: 1.25rem;">
        <div style="color: #64748b; font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">Total Revenue</div>
        <div style="font-size: 1.75rem; font-weight: 800; color: #f97316; margin-top: 0.35rem;">₹@Model.TotalAmount.ToString("N2")</div>
    </div>
</div>

<!-- Kitchen Food Preparation Quantities -->
<div style="background: white; border-radius: 16px; border: 1px solid #e2e8f0; padding: 1.75rem; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);">
    <h3 style="font-size: 1.2rem; font-weight: 800; color: #0f172a; margin-bottom: 0.25rem;">👨‍🍳 Kitchen Item Prep Counts</h3>
    <p style="color: #64748b; font-size: 0.85rem; margin-bottom: 1.5rem;">Aggregated quantities needed for kitchen cooking.</p>

    @if (Model.FoodSummary == null || !Model.FoodSummary.Any())
    {
        <p style="color: #94a3b8; font-size: 0.9rem; text-align: center; padding: 2rem 0;">No food items to prepare yet today.</p>
    }
    else
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem;">
            @foreach (var item in Model.FoodSummary)
            {
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1rem 1.25rem; display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-weight: 700; color: #1e293b; font-size: 0.95rem;">@item.FoodName</span>
                    <span style="background: #f97316; color: white; font-weight: 800; font-size: 0.9rem; padding: 0.25rem 0.65rem; border-radius: 9999px;">
                        @item.TotalQuantity portions
                    </span>
                </div>
            }
        </div>
    }
</div>
