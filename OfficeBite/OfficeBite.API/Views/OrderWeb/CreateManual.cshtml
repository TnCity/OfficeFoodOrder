@model OfficeBite.API.Controllers.CreateManualOrderViewModel
@{
    ViewData["Title"] = "Create Manual Order for Employee";
    var menu = Model.Menu;
}

<div style="max-width: 960px; margin: 0 auto; padding-bottom: 3rem;">
    <!-- Breadcrumb / Back Link -->
    <div style="margin-bottom: 1.25rem;">
        <a href="/web/orders" style="display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; color: #64748b; font-size: 0.9rem; font-weight: 600;">
            ← Back to Orders List
        </a>
    </div>

    <!-- Header Card -->
    <div style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%); border-radius: 20px; padding: 2rem; color: white; margin-bottom: 2rem; box-shadow: 0 10px 25px -5px rgba(67, 56, 202, 0.3);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
            <div>
                <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(255, 255, 255, 0.15); padding: 0.35rem 0.85rem; border-radius: 999px; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.75rem; backdrop-filter: blur(8px);">
                    👑 Admin Manual Entry
                </div>
                <h1 style="font-size: 1.85rem; font-weight: 800; line-height: 1.2; margin-bottom: 0.5rem;">
                    Create Manual Order for Employee
                </h1>
                <p style="color: #c7d2fe; font-size: 0.95rem; max-width: 650px; line-height: 1.5; margin: 0;">
                    Enter any employee or guest name, select today's dishes, and add any custom off-menu dishes with custom prices.
                </p>
            </div>
            <div style="background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 14px; padding: 0.75rem 1.25rem; text-align: right; backdrop-filter: blur(8px);">
                <div style="font-size: 0.75rem; color: #a5b4fc; text-transform: uppercase; font-weight: 700;">Menu Date</div>
                <div style="font-size: 1.1rem; font-weight: 800; color: white;">
                    @(menu != null ? menu.MenuDate.ToString("dd MMM yyyy") : DateTime.Today.ToString("dd MMM yyyy"))
                </div>
            </div>
        </div>
    </div>

    <!-- Main Order Form -->
    <form asp-action="CreateManual" method="post" id="manualOrderForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="MenuId" value="@(menu?.MenuId ?? 0)" />

        <!-- 1. Employee Name Section -->
        <div style="background: white; border-radius: 18px; padding: 1.75rem; border: 1px solid #e2e8f0; margin-bottom: 1.75rem; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem;">
                <div style="width: 36px; height: 36px; border-radius: 10px; background: #e0e7ff; color: #4338ca; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; font-weight: 800;">
                    1
                </div>
                <div>
                    <h3 style="font-size: 1.15rem; font-weight: 800; color: #0f172a; margin: 0;">Employee Name *</h3>
                    <p style="font-size: 0.85rem; color: #64748b; margin: 0.15rem 0 0 0;">
                        Type the employee's name directly (not restricted to pre-registered users).
                    </p>
                </div>
            </div>

            <div style="position: relative;">
                <input type="text"
                       name="EmployeeName"
                       id="employeeNameInput"
                       required
                       placeholder="Type employee name (e.g. Rahul Sharma, Priya Patel, John Doe)..."
                       style="width: 100%; padding: 0.9rem 1.25rem; font-size: 1.05rem; font-weight: 600; color: #0f172a; border: 2px solid #cbd5e1; border-radius: 12px; outline: none; transition: all 0.2s ease; background: #f8fafc;"
                       onfocus="this.style.borderColor='#4338ca'; this.style.background='white'; this.style.boxShadow='0 0 0 4px rgba(67, 56, 202, 0.1)';"
                       onblur="this.style.borderColor='#cbd5e1'; this.style.boxShadow='none';" />
            </div>
        </div>

        <!-- 2. Today's Available Menu Items (Optional Selection with Price Box) -->
        <div style="background: white; border-radius: 18px; padding: 1.75rem; border: 1px solid #e2e8f0; margin-bottom: 1.75rem; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <div style="width: 36px; height: 36px; border-radius: 10px; background: #e0e7ff; color: #4338ca; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; font-weight: 800;">
                        2
                    </div>
                    <div>
                        <h3 style="font-size: 1.15rem; font-weight: 800; color: #0f172a; margin: 0;">Today's Menu Dishes</h3>
                        <p style="font-size: 0.85rem; color: #64748b; margin: 0.15rem 0 0 0;">
                            Select portions and adjust/override item price if needed.
                        </p>
                    </div>
                </div>
            </div>

            @if (menu != null && menu.Items != null && menu.Items.Any())
            {
                <div style="display: flex; flex-direction: column; gap: 0.85rem;">
                    @for (int i = 0; i < menu.Items.Count; i++)
                    {
                        var item = menu.Items[i];
                        bool isVeg = item.FoodName.Contains("Veg", StringComparison.OrdinalIgnoreCase) ||
                                     item.FoodName.Contains("Paneer", StringComparison.OrdinalIgnoreCase) ||
                                     item.FoodName.Contains("Dal", StringComparison.OrdinalIgnoreCase) ||
                                     item.FoodName.Contains("Roti", StringComparison.OrdinalIgnoreCase) ||
                                     item.FoodName.Contains("Rice", StringComparison.OrdinalIgnoreCase);

                        <div class="menu-item-row" style="display: grid; grid-template-columns: 1fr auto auto auto; align-items: center; gap: 1rem; padding: 1rem 1.25rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; transition: all 0.2s ease;">
                            <input type="hidden" name="Items[@i].MenuItemId" value="@item.MenuItemId" />
                            <input type="hidden" name="Items[@i].FoodName" value="@item.FoodName" />

                            <!-- Dish Name & Veg/NonVeg Indicator -->
                            <div>
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    <span style="font-size: 1rem; font-weight: 700; color: #1e293b;">@item.FoodName</span>
                                    <span style="font-size: 0.72rem; padding: 0.15rem 0.5rem; border-radius: 6px; font-weight: 700; @(isVeg ? "background: #dcfce7; color: #166534;" : "background: #fee2e2; color: #991b1b;")">
                                        @(isVeg ? "🟢 VEG" : "🔴 NON-VEG")
                                    </span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <div style="font-size: 0.8rem; color: #64748b; margin-top: 0.2rem;">@item.Description</div>
                                }
                            </div>

                            <!-- Price Box (Editable by Admin) -->
                            <div style="display: flex; align-items: center; gap: 0.4rem;">
                                <span style="font-size: 0.9rem; font-weight: 700; color: #475569;">₹</span>
                                <input type="number"
                                       step="0.5"
                                       min="0"
                                       name="Items[@i].UnitPrice"
                                       id="price_@i"
                                       value="@item.Price"
                                       oninput="calculateTotal()"
                                       style="width: 85px; padding: 0.5rem 0.6rem; font-size: 0.95rem; font-weight: 700; color: #0f172a; border: 1.5px solid #cbd5e1; border-radius: 8px; text-align: right; background: white;"
                                       title="Item unit price (editable)" />
                            </div>

                            <!-- Quantity Stepper -->
                            <div style="display: flex; align-items: center; background: white; border: 1.5px solid #cbd5e1; border-radius: 10px; overflow: hidden;">
                                <button type="button"
                                        onclick="changeQty('qty_@i', -1)"
                                        style="width: 36px; height: 36px; background: transparent; border: none; font-size: 1.1rem; font-weight: bold; color: #4338ca; cursor: pointer;">
                                    −
                                </button>
                                <input type="number"
                                       min="0"
                                       name="Items[@i].Quantity"
                                       id="qty_@i"
                                       value="0"
                                       class="item-qty-input"
                                       data-price-id="price_@i"
                                       oninput="calculateTotal()"
                                       style="width: 44px; height: 36px; border: none; text-align: center; font-weight: 800; font-size: 0.95rem; color: #0f172a; outline: none;" />
                                <button type="button"
                                        onclick="changeQty('qty_@i', 1)"
                                        style="width: 36px; height: 36px; background: transparent; border: none; font-size: 1.1rem; font-weight: bold; color: #4338ca; cursor: pointer;">
                                    +
                                </button>
                            </div>

                            <!-- Subtotal for this item -->
                            <div id="subtotal_@i" style="font-size: 0.95rem; font-weight: 800; color: #4338ca; min-width: 70px; text-align: right;">
                                ₹0.00
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="padding: 1.5rem; text-align: center; background: #f8fafc; border-radius: 12px; color: #64748b; font-size: 0.9rem;">
                    No dishes published in today's menu. You can add custom off-menu dishes below!
                </div>
            }
        </div>

        <!-- 3. Custom / Off-Menu Dishes (Dynamic Rows with Name & Price Box) -->
        <div style="background: white; border-radius: 18px; padding: 1.75rem; border: 1px solid #e2e8f0; margin-bottom: 1.75rem; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.75rem;">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <div style="width: 36px; height: 36px; border-radius: 10px; background: #fef3c7; color: #b45309; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; font-weight: 800;">
                        3
                    </div>
                    <div>
                        <h3 style="font-size: 1.15rem; font-weight: 800; color: #0f172a; margin: 0;">Custom & Off-Menu Dishes</h3>
                        <p style="font-size: 0.85rem; color: #64748b; margin: 0.15rem 0 0 0;">
                            Add any special dishes not present on the daily menu with custom prices.
                        </p>
                    </div>
                </div>

                <button type="button"
                        onclick="addCustomDishRow()"
                        style="display: inline-flex; align-items: center; gap: 0.5rem; background: #f8fafc; border: 1.5px dashed #4338ca; color: #4338ca; font-weight: 700; font-size: 0.88rem; padding: 0.6rem 1.1rem; border-radius: 10px; cursor: pointer; transition: all 0.2s ease;"
                        onmouseover="this.style.background='#e0e7ff'"
                        onmouseout="this.style.background='#f8fafc'">
                    ➕ Add Custom Dish
                </button>
            </div>

            <!-- Custom Dishes Container -->
            <div id="customDishesContainer" style="display: flex; flex-direction: column; gap: 0.85rem;">
                <!-- Dynamically populated via JS or default empty -->
            </div>

            <div id="noCustomDishesNotice" style="padding: 1.25rem; text-align: center; border: 1.5px dashed #e2e8f0; border-radius: 12px; color: #94a3b8; font-size: 0.88rem;">
                Click <strong>"➕ Add Custom Dish"</strong> above if the employee ordered special food items not in the menu.
            </div>
        </div>

        <!-- 4. Special Instructions -->
        <div style="background: white; border-radius: 18px; padding: 1.75rem; border: 1px solid #e2e8f0; margin-bottom: 2rem; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
                <div style="width: 36px; height: 36px; border-radius: 10px; background: #f1f5f9; color: #475569; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; font-weight: 800;">
                    4
                </div>
                <div>
                    <h3 style="font-size: 1.15rem; font-weight: 800; color: #0f172a; margin: 0;">Special Instructions (Optional)</h3>
                    <p style="font-size: 0.85rem; color: #64748b; margin: 0.15rem 0 0 0;">
                        Preparation notes, dietary constraints, or delivery room details.
                    </p>
                </div>
            </div>

            <textarea name="SpecialInstructions"
                      rows="2"
                      placeholder="e.g. Less spicy, pack in separate containers, deliver to Executive Meeting Room..."
                      style="width: 100%; padding: 0.85rem 1rem; border: 1.5px solid #cbd5e1; border-radius: 12px; font-size: 0.95rem; color: #0f172a; outline: none; transition: border 0.2s; resize: vertical;"
                      onfocus="this.style.borderColor='#4338ca'"
                      onblur="this.style.borderColor='#cbd5e1'"></textarea>
        </div>

        <!-- 5. Sticky Bottom Summary & Place Order Bar -->
        <div style="background: white; border-radius: 20px; padding: 1.25rem 2rem; border: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.25rem; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08); position: sticky; bottom: 1.5rem; z-index: 50;">
            <div>
                <div style="font-size: 0.8rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em;">
                    Total Manual Order Value
                </div>
                <div style="display: flex; align-items: baseline; gap: 0.5rem; margin-top: 0.2rem;">
                    <span id="grandTotalDisplay" style="font-size: 1.9rem; font-weight: 800; color: #4338ca;">₹0.00</span>
                    <span id="itemCountDisplay" style="font-size: 0.9rem; font-weight: 600; color: #64748b;">(0 portions)</span>
                </div>
            </div>

            <div style="display: flex; gap: 0.75rem; align-items: center;">
                <a href="/web/orders" class="btn btn-secondary" style="padding: 0.85rem 1.4rem; font-weight: 600;">
                    Cancel
                </a>
                <button type="submit"
                        id="submitOrderBtn"
                        class="btn btn-primary"
                        style="padding: 0.85rem 2rem; font-size: 1.05rem; font-weight: 800; background: linear-gradient(135deg, #4338ca 0%, #6366f1 100%); border: none; box-shadow: 0 4px 15px rgba(67, 56, 202, 0.35);">
                    ⚡ Place Manual Order
                </button>
            </div>
        </div>
    </form>
</div>

<script>
    let customItemIndex = 1000;

    function changeQty(inputId, delta) {
        const input = document.getElementById(inputId);
        if (!input) return;
        let current = parseInt(input.value) || 0;
        current = Math.max(0, current + delta);
        input.value = current;
        calculateTotal();
    }

    function addCustomDishRow() {
        const container = document.getElementById('customDishesContainer');
        const notice = document.getElementById('noCustomDishesNotice');
        if (notice) notice.style.display = 'none';

        const index = customItemIndex++;
        const row = document.createElement('div');
        row.id = `customRow_${index}`;
        row.className = 'custom-dish-row';
        row.style.cssText = 'display: grid; grid-template-columns: 1fr auto auto auto auto; align-items: center; gap: 0.85rem; padding: 1rem 1.25rem; background: #fffbeb; border: 1.5px solid #fde68a; border-radius: 14px; animation: fadeIn 0.2s ease;';

        row.innerHTML = `
            <input type="hidden" name="Items[${index}].MenuItemId" value="0" />
            <div>
                <input type="text"
                       name="Items[${index}].FoodName"
                       placeholder="Enter Custom Dish Name (e.g. Special Chicken Roll, Diet Salad)..."
                       required
                       style="width: 100%; padding: 0.55rem 0.85rem; font-size: 0.95rem; font-weight: 600; color: #0f172a; border: 1.5px solid #cbd5e1; border-radius: 8px; background: white;" />
            </div>
            <div style="display: flex; align-items: center; gap: 0.35rem;">
                <span style="font-size: 0.9rem; font-weight: 700; color: #b45309;">₹</span>
                <input type="number"
                       step="0.5"
                       min="0"
                       name="Items[${index}].UnitPrice"
                       id="price_${index}"
                       value="100"
                       placeholder="Price"
                       required
                       oninput="calculateTotal()"
                       style="width: 85px; padding: 0.5rem 0.6rem; font-size: 0.95rem; font-weight: 700; color: #0f172a; border: 1.5px solid #cbd5e1; border-radius: 8px; text-align: right; background: white;"
                       title="Custom dish price" />
            </div>
            <div style="display: flex; align-items: center; background: white; border: 1.5px solid #cbd5e1; border-radius: 10px; overflow: hidden;">
                <button type="button"
                        onclick="changeQty('qty_${index}', -1)"
                        style="width: 36px; height: 36px; background: transparent; border: none; font-size: 1.1rem; font-weight: bold; color: #b45309; cursor: pointer;">
                    −
                </button>
                <input type="number"
                       min="1"
                       name="Items[${index}].Quantity"
                       id="qty_${index}"
                       value="1"
                       class="item-qty-input"
                       data-price-id="price_${index}"
                       oninput="calculateTotal()"
                       style="width: 44px; height: 36px; border: none; text-align: center; font-weight: 800; font-size: 0.95rem; color: #0f172a; outline: none;" />
                <button type="button"
                        onclick="changeQty('qty_${index}', 1)"
                        style="width: 36px; height: 36px; background: transparent; border: none; font-size: 1.1rem; font-weight: bold; color: #b45309; cursor: pointer;">
                    +
                </button>
            </div>
            <div id="subtotal_${index}" style="font-size: 0.95rem; font-weight: 800; color: #b45309; min-width: 70px; text-align: right;">
                ₹100.00
            </div>
            <div>
                <button type="button"
                        onclick="removeCustomDishRow(${index})"
                        title="Remove dish"
                        style="background: #fee2e2; color: #dc2626; border: none; border-radius: 8px; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; font-size: 1rem; cursor: pointer;">
                    🗑️
                </button>
            </div>
        `;

        container.appendChild(row);
        calculateTotal();
    }

    function removeCustomDishRow(index) {
        const row = document.getElementById(`customRow_${index}`);
        if (row) row.remove();

        const container = document.getElementById('customDishesContainer');
        const notice = document.getElementById('noCustomDishesNotice');
        if (container.children.length === 0 && notice) {
            notice.style.display = 'block';
        }
        calculateTotal();
    }

    function calculateTotal() {
        let total = 0;
        let portions = 0;

        const qtyInputs = document.querySelectorAll('.item-qty-input');
        qtyInputs.forEach(input => {
            const qty = parseInt(input.value) || 0;
            const priceId = input.getAttribute('data-price-id');
            const priceInput = document.getElementById(priceId);
            const unitPrice = priceInput ? (parseFloat(priceInput.value) || 0) : 0;
            const subtotal = qty * unitPrice;

            const subtotalElemId = input.id.replace('qty_', 'subtotal_');
            const subtotalElem = document.getElementById(subtotalElemId);
            if (subtotalElem) {
                subtotalElem.textContent = '₹' + subtotal.toFixed(2);
            }

            if (qty > 0) {
                total += subtotal;
                portions += qty;
            }
        });

        document.getElementById('grandTotalDisplay').textContent = '₹' + total.toFixed(2);
        document.getElementById('itemCountDisplay').textContent = `(${portions} portion${portions === 1 ? '' : 's'})`;
    }

    document.addEventListener('DOMContentLoaded', () => {
        calculateTotal();
    });
</script>

<style>
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-5px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
