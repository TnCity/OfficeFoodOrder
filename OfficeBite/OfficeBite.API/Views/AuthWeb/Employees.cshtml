@model List<OfficeBite.Shared.DTOs.EmployeeLookupDto>
@{
    ViewData["Title"] = "Employee Directory";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
        <h1 style="font-size: 1.75rem; font-weight: 800; color: #0f172a;">Employee Directory</h1>
        <p style="color: #64748b; font-size: 0.95rem; margin-top: 0.25rem;">List of all registered employees and staff.</p>
    </div>
    <a href="/web/auth/register" class="btn btn-primary btn-sm">+ Add New Employee</a>
</div>

@if (Model == null || !Model.Any())
{
    <div style="background: white; border-radius: 16px; padding: 3rem; text-align: center; border: 1px dashed #cbd5e1;">
        <p style="color: #64748b;">No employees registered yet.</p>
    </div>
}
else
{
    <div style="background: white; border-radius: 16px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
            <thead>
                <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #475569; font-weight: 700; font-size: 0.8rem; text-transform: uppercase;">
                    @* <th style="padding: 1rem 1.25rem;">ID</th> *@
                    <th style="padding: 1rem 1.25rem;">Name</th>
                    <th style="padding: 1rem 1.25rem;">Email</th>
                    <th style="padding: 1rem 1.25rem;">Mobile</th>
                    <th style="padding: 1rem 1.25rem;">Role</th>
                    @* <th style="padding: 1rem 1.25rem; text-align: right;">Action</th> *@
                </tr>
            </thead>
            <tbody>
                @foreach (var emp in Model)
                {
                    <tr style="border-bottom: 1px solid #f1f5f9;">
                        @* <td style="padding: 1rem 1.25rem; font-weight: 700; color: #64748b;">#@emp.UserId</td> *@
                        <td style="padding: 1rem 1.25rem; font-weight: 600; color: #0f172a;">@emp.FullName</td>
                        <td style="padding: 1rem 1.25rem; color: #334155;">@emp.Email</td>
                        <td style="padding: 1rem 1.25rem; color: #64748b;">@emp.Mobile</td>
                        <td style="padding: 1rem 1.25rem;">
                            <span class="badge @(emp.Role == "Admin" ? "badge-confirmed" : "badge-pending")">@emp.Role</span>
                        </td>
                        @* <td style="padding: 1rem 1.25rem; text-align: right;">
                            <form asp-action="ToggleRole" asp-route-userId="@emp.UserId" method="post" style="display: inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-secondary btn-sm" style="font-size: 0.78rem;">
                                    @(emp.Role == "Admin" ? "Demote to Employee" : "Promote to Admin")
                                </button>
                            </form>
                        </td> *@
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
