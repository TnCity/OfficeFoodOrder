@model OfficeBite.API.Controllers.HomeDashboardViewModel
@{
    ViewData["Title"] = "Home Dashboard";
}

<!-- Welcome Hero Banner -->
<div style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border-radius: 20px; padding: 2.25rem 2.5rem; color: white; margin-bottom: 2rem; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.15); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem;">
    <div>
        <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(249, 115, 22, 0.2); border: 1px solid rgba(249, 115, 22, 0.4); color: #fb923c; font-size: 0.8rem; font-weight: 700; padding: 0.35rem 0.85rem; border-radius: 9999px; text-transform: uppercase; margin-bottom: 0.85rem;">
            <span>👑</span> Admin Console
        </div>
        <h1 style="font-size: 2rem; font-weight: 800; letter-spacing: -0.02em;">Welcome back, @Model.CurrentUserName! 👋</h1>
        <p style="color: #94a3b8; font-size: 1rem; margin-top: 0.35rem; max-width: 540px;">
            Manage daily catering menus, live employee food orders, and kitchen preparation workflows in real-time.
        </p>
    </div>

    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <a href="/web/menu" class="btn btn-primary" style="padding: 0.75rem 1.35rem; font-size: 0.95rem;">
            🍱 Today's Menu
        </a>
        <a href="/web/orders" class="btn btn-secondary" style="padding: 0.75rem 1.35rem; font-size: 0.95rem; background: rgba(255,255,255,0.1); color: white; border: 1px solid rgba(255,255,255,0.2);">
            📋 View Orders
        </a>
    </div>
</div>

<!-- Live KPI Metrics Row -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
    <!-- Today's Menu Status -->
    <a href="/web/menu" style="text-decoration: none; color: inherit;">
        <div style="background: white; border-radius: 16px; border: 1px solid #e2e8f0; padding: 1.5rem; box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='none'">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <span style="font-size: 1.75rem;">🍱</span>
                @if (Model.TodayMenu != null && Model.TodayMenu.IsPublished)
                {
                    <span class="badge badge-delivered">Live</span>
                }
                else if (Model.TodayMenu != null)
                {
                    <span class="badge badge-pending">Draft</span>
                }
                else
                {
                    <span class="badge badge-cancelled">Not Set</span>
                }
            </div>
            <div style="color: #64748b; font-size: 0.825rem; font-weight: 700; text-transform: uppercase;">Daily Menu</div>
            <div style="font-size: 1.4rem; font-weight: 800; color: #0f172a; margin-top: 0.25rem;">
                @(Model.TodayMenu?.Items.Count ?? 0) Dishes
            </div>
            <div style="font-size: 0.8rem; color: #f97316; font-weight: 600; margin-top: 0.5rem;">
                @(Model.TodayMenu?.IsOrderingOpen == true ? "🟢 Ordering is Open" : "🔴 Ordering Closed")
            </div>
        </div>
    </a>

    <!-- Today's Total Orders -->
    <a href="/web/orders?filter=today" style="text-decoration: none; color: inherit;">
        <div style="background: white; border-radius: 16px; border: 1px solid #e2e8f0; padding: 1.5rem; box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='none'">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <span style="font-size: 1.75rem;">📋</span>
                <span class="badge badge-confirmed">Today</span>
            </div>
            <div style="color: #64748b; font-size: 0.825rem; font-weight: 700; text-transform: uppercase;">Today's Orders</div>
            <div style="font-size: 1.4rem; font-weight: 800; color: #0f172a; margin-top: 0.25rem;">
                @(Model.TodaySummary?.TotalOrders ?? 0) Orders
            </div>
            <div style="font-size: 0.8rem; color: #0284c7; font-weight: 600; margin-top: 0.5rem;">
                @(Model.TodaySummary?.PendingOrders ?? 0) Pending · @(Model.TodaySummary?.DeliveredOrders ?? 0) Delivered
            </div>
        </div>
    </a>

    <!-- Today's Revenue -->
    <a href="/web/orders/today-summary" style="text-decoration: none; color: inherit;">
        <div style="background: white; border-radius: 16px; border: 1px solid #e2e8f0; padding: 1.5rem; box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='none'">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <span style="font-size: 1.75rem;">💰</span>
                <span class="badge badge-delivered">Sales</span>
            </div>
            <div style="color: #64748b; font-size: 0.825rem; font-weight: 700; text-transform: uppercase;">Today's Revenue</div>
            <div style="font-size: 1.4rem; font-weight: 800; color: #f97316; margin-top: 0.25rem;">
                ₹@((Model.TodaySummary?.TotalAmount ?? 0).ToString("N2"))
            </div>
            <div style="font-size: 0.8rem; color: #16a34a; font-weight: 600; margin-top: 0.5rem;">
                Kitchen Order Flow Active
            </div>
        </div>
    </a>

    <!-- Registered Employees -->
    <a href="/web/auth/employees" style="text-decoration: none; color: inherit;">
        <div style="background: white; border-radius: 16px; border: 1px solid #e2e8f0; padding: 1.5rem; box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='none'">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <span style="font-size: 1.75rem;">👥</span>
                <span class="badge badge-cooking">Staff</span>
            </div>
            <div style="color: #64748b; font-size: 0.825rem; font-weight: 700; text-transform: uppercase;">Staff Directory</div>
            <div style="font-size: 1.4rem; font-weight: 800; color: #0f172a; margin-top: 0.25rem;">
                @Model.TotalEmployees Employees
            </div>
            <div style="font-size: 0.8rem; color: #64748b; font-weight: 600; margin-top: 0.5rem;">
                Manage Roles & Permissions ↗
            </div>
        </div>
    </a>
</div>

<!-- Two Column Content Grid -->
<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; align-items: start;">
    <!-- Left: Quick Actions & Kitchen Items Prep -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <!-- Kitchen Prep Aggregation -->
        <div style="background: white; border-radius: 16px; border: 1px solid #e2e8f0; padding: 1.75rem; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                <div>
                    <h2 style="font-size: 1.25rem; font-weight: 800; color: #0f172a;">👨‍🍳 Today's Kitchen Prep Portions</h2>
                    <p style="color: #64748b; font-size: 0.85rem;">Quantities required to cook for today's orders.</p>
                </div>
                <a href="/web/orders/today-summary" class="btn btn-secondary btn-sm">Full Report →</a>
            </div>

            @if (Model.TodaySummary?.FoodSummary == null || !Model.TodaySummary.FoodSummary.Any())
            {
                <div style="padding: 2.5rem; text-align: center; color: #94a3b8; font-size: 0.9rem; background: #f8fafc; border-radius: 12px;">
                    No food items ordered yet today.
                </div>
            }
            else
            {
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.85rem;">
                    @foreach (var item in Model.TodaySummary.FoodSummary)
                    {
                        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 0.9rem 1.1rem; display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-weight: 700; color: #1e293b; font-size: 0.9rem;">@item.FoodName</span>
                            <span style="background: #f97316; color: white; font-weight: 800; font-size: 0.85rem; padding: 0.2rem 0.6rem; border-radius: 9999px;">
                                x@(item.TotalQuantity)
                            </span>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Recent Orders Activity -->
        <div style="background: white; border-radius: 16px; border: 1px solid #e2e8f0; padding: 1.75rem; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                <div>
                    <h2 style="font-size: 1.25rem; font-weight: 800; color: #0f172a;">Recent Orders</h2>
                    <p style="color: #64748b; font-size: 0.85rem;">Latest orders placed by team members.</p>
                </div>
                <a href="/web/orders" class="btn btn-secondary btn-sm">All Orders →</a>
            </div>

            @if (Model.RecentOrders == null || !Model.RecentOrders.Any())
            {
                <p style="color: #94a3b8; font-size: 0.9rem; text-align: center; padding: 2rem;">No recent orders recorded.</p>
            }
            else
            {
                <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #475569; font-weight: 700; font-size: 0.78rem; text-transform: uppercase;">
                            <th style="padding: 0.75rem 1rem; text-align: left;">Order</th>
                            <th style="padding: 0.75rem 1rem; text-align: left;">Employee</th>
                            <th style="padding: 0.75rem 1rem; text-align: right;">Amount</th>
                            <th style="padding: 0.75rem 1rem; text-align: center;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr style="border-bottom: 1px solid #f8fafc;">
                                <td style="padding: 0.75rem 1rem; font-weight: 700;">
                                    <a href="/web/orders/details/@order.OrderId" style="color: #0f172a; text-decoration: none;">#@order.OrderId</a>
                                </td>
                                <td style="padding: 0.75rem 1rem; color: #334155;">@order.UserName</td>
                                <td style="padding: 0.75rem 1rem; text-align: right; font-weight: 700; color: #f97316;">₹@order.TotalAmount.ToString("N2")</td>
                                <td style="padding: 0.75rem 1rem; text-align: center;">
                                    <span class="badge badge-confirmed" style="font-size: 0.7rem;">@order.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- Right Column: Quick Shortcuts -->
    <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        <div style="background: white; border-radius: 16px; border: 1px solid #e2e8f0; padding: 1.5rem; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);">
            <h3 style="font-size: 1.1rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">⚡ Quick Admin Actions</h3>
            
            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                <a href="/web/menu" class="btn btn-secondary" style="justify-content: flex-start; padding: 0.75rem 1rem;">
                    <span>🍱</span> Manage Daily Menu
                </a>
                <a href="/web/orders" class="btn btn-secondary" style="justify-content: flex-start; padding: 0.75rem 1rem;">
                    <span>📋</span> Manage All Orders
                </a>
                <a href="/web/orders/today-summary" class="btn btn-secondary" style="justify-content: flex-start; padding: 0.75rem 1rem;">
                    <span>📊</span> Kitchen Today's Summary
                </a>
                <a href="/web/auth/employees" class="btn btn-secondary" style="justify-content: flex-start; padding: 0.75rem 1rem;">
                    <span>👥</span> Manage Staff & Roles
                </a>
                <a href="/swagger" target="_blank" class="btn btn-secondary" style="justify-content: flex-start; padding: 0.75rem 1rem; color: #64748b;">
                    <span>📄</span> Swagger REST API Docs ↗
                </a>
            </div>
        </div>

        <div style="background: linear-gradient(135deg, #fff7ed, #ffedd5); border-radius: 16px; border: 1px solid #fed7aa; padding: 1.5rem;">
            <div style="font-weight: 800; color: #9a3412; font-size: 1rem; margin-bottom: 0.35rem;">Mobile App Connected</div>
            <p style="color: #c2410c; font-size: 0.85rem; line-height: 1.4;">
                Employees place orders directly from the <strong>OfficeBite.Mobile</strong> Android app or via the Web Portal. All changes sync in real-time.
            </p>
        </div>
    </div>
</div>
